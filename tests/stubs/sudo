#!/usr/bin/env bash
# sudo stub: log the call, drop sudo's own options (-n, -H, -E, -v, -u USER,
# --), then run the command without privileges. STUB_EXIT_sudo=N fails the
# call with N instead.
printf 'sudo %s\n' "$*" >> "${STUB_LOG:-/dev/null}"
[ "${STUB_EXIT_sudo:-0}" = 0 ] || exit "${STUB_EXIT_sudo}"
while [ $# -gt 0 ]; do
  case "$1" in
    -n|-H|-E|-v) shift ;;
    -u) shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || exit 0
exec "$@"
